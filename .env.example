# Copy to .env (never commit it). The agent reads it at start.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash
# backup provider: LLM_PROVIDER=groq
GROQ_API_KEY=
# Tracing (optional; leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Tools
PROM_URL=http://localhost:9090
READER_KUBECONFIG=.kube/reader.yaml
